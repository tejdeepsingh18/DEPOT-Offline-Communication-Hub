# ==================================================================
# DEPOT — systemd service for the DHCP server (dnsmasq)
# ==================================================================
# dnsmasq is the polite clerk who hands out IP addresses to every device
# that joins the "depot" Wi-Fi network.
#
# Where it lives on the Pi: /etc/systemd/system/dnsmasq-depot.service
# Registered with:          sudo systemctl enable --now dnsmasq-depot

[Unit]
Description=DEPOT DHCP server (dnsmasq)
# DHCP isn't useful until the Wi-Fi AP (hostapd) is up — nobody can "join"
# a network that doesn't exist yet, so we wait for it.
After=hostapd-depot.service
# if hostapd dies, dnsmasq goes down too
Requires=hostapd-depot.service

[Service]
Type=simple
# -C = "use this exact config file, ignore system defaults"
# -x = where to keep this instance's PID file (number = process identity)
# --user/--group = run as root here (simpler than creating a special user —
#                  the normal 'dnsmasq' system user wasn't auto-created by
#                  apt on our image, which is a bug we hit.)
# --no-daemon = stay in the foreground, so systemd can watch the process.
ExecStart=/usr/sbin/dnsmasq -C /home/netpie/depot/dnsmasq-depot.conf \
                            -x /run/dnsmasq-depot.pid \
                            --user=root --group=root --no-daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# ==================================================================
# HANDY NOTES
# ==================================================================
# A common failure mode we hit:
#     "dnsmasq: failed to create listening socket for 10.42.0.1:
#      Address already in use"
# That means something ELSE is already using port 53 on 10.42.0.1.
# In our case, NetworkManager had slily re-activated a deleted hotspot
# profile and spawned its own dnsmasq. To see who's holding the port:
#     sudo ss -ulpn | grep 53
# Then kill that other process, or delete the profile that spawned it.
